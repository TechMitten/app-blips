# ── Core (required in every hosting mode) ──────────────────────────────────
ORION_LLM_BASE_URL=https://api.openai.com/v1
ORION_LLM_API_KEY=
ORION_LLM_MODEL=gpt-4o
ORION_LLM_MAX_TOKENS=
ORION_LLM_REASONING_EFFORT=none

# Optional per-user rate limit on /api/chat. Defaults: 60 requests / 300s.
ORION_CHAT_RATE_LIMIT_MAX=
ORION_CHAT_RATE_LIMIT_WINDOW_SECONDS=

# ── Auth mode ────────────────────────────────────────────────────────────
# Self-hosted mode is the default when these are unset or anything other than
# "true": the app runs as a single local user with no sign-in, no cloud
# project sync, and no deploy-to-public-URL feature. Set both to "true" to
# use Firebase Auth (hosted mode) -- they must be set consistently, since
# VITE_USE_FIREBASE is read by the browser bundle and USE_FIREBASE by the
# server-side /api/chat proxy (different runtimes, so both are needed).
VITE_USE_FIREBASE=false
USE_FIREBASE=false

# ── Firebase (hosted mode only -- leave unset for self-hosting) ────────────
# NOTE: when USE_FIREBASE=false, /api/chat does not authenticate requests --
# every call is treated as the single local user. Self-hosters exposing this
# app beyond localhost are responsible for their own access control.
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
# VITE_FIREBASE_RECAPTCHA_SITE_KEY=
# FIREBASE_API_KEY=
