# ═════════════════════════════════════════════════════════════════════════════
#  AppBlips — configuration
#
#  Using the desktop app? You don't need this file: set your AI provider in
#  the app under Settings → AI.
#
#  1. Copy this file to .env
#  2. Fill in STEP 1 (an API key and a model) -- that is all a single-user
#     install needs.
#  3. Start the app. It prints which AI provider it found.
#
#  Everything else is optional. Blank lines mean "use the default".
#
#  AppBlips is designed as a single-user application: one local user, no sign-in.
#  Projects are saved locally in the browser. /api/chat performs no authentication,
#  so keep it on localhost or behind your own access control.
# ═════════════════════════════════════════════════════════════════════════════


# ── STEP 1 (required): your AI provider ─────────────────────────────────────
# Fill in the API key for ONE provider. The provider whose key is filled in
# becomes active; leave the others blank.
# Alternatively, leave STEP 1 blank and choose a provider, model and key in the
# app under Settings → AI (stored in your browser only).
# OpenRouter gives you Claude, Gemini and most other models with one key.
APPBLIPS_OPENROUTER_API_KEY=

# The model to use, written exactly as your provider names it. For example:
#   OpenRouter  anthropic/claude-3.5-sonnet   or   deepseek/deepseek-v4-pro
APPBLIPS_LLM_MODEL=


# ── STEP 2 (optional): limits and tuning ────────────────────────────────────
# Maximum length of one builder response, in tokens. Blank = provider default.
APPBLIPS_LLM_MAX_TOKENS=
# Sampling temperature for the builder. Blank = 0.2.
APPBLIPS_LLM_TEMPERATURE=
# /api/chat refuses browser requests from pages other than AppBlips itself.
# Only needed behind a reverse proxy that rewrites the Host header: list the
# address you open AppBlips at, comma-separated and exact.
APPBLIPS_CHAT_ALLOWED_ORIGINS=


# ── Advanced ────────────────────────────────────────────────────────────────
# The OPENAI_* names are the general settings for whichever OpenAI-compatible
# endpoint is active (they replace APPBLIPS_LLM_*, which still work).
# OPENAI_API_KEY is also the fallback key for any provider.
# Any other OpenAI-compatible service (Ollama, vLLM, LiteLLM, Groq, ...):
# fill in the base URL, an API key (Ollama needs none: put any text) and the
# model in STEP 1's APPBLIPS_LLM_MODEL. On a named provider above, the base URL
# instead overrides that provider's default endpoint.
OPENAI_BASE_URL=
OPENAI_API_KEY=

# Choose the provider explicitly when more than one key is filled in:
# openrouter or openai-compatible.
OPENAI_LLM_PROVIDER=

# How the provider expects the reasoning setting: reasoning_effort, reasoning,
# thinking or omit (send nothing). Blank = the provider's usual format.
OPENAI_LLM_REASONING_PARAM=
# Token cap for Ask-mode chat replies only. Blank = 8192.
OPENAI_LLM_ASK_MAX_TOKENS=
# Optional models for particular jobs, on the same provider and key. Blank =
# APPBLIPS_LLM_MODEL. VISION is used for any request with an attached image, so
# a text-only main model can still read screenshots. ASK is used for Ask-mode
# chat (only for Plus and Pro when billing is on).
OPENAI_LLM_VISION_MODEL=
OPENAI_LLM_ASK_MODEL=



# ── Generated-app AI ────────────────────────────────────────────────────────
# Prefer that each person using a finished app brings their own key instead of
# using yours? Set this to byok. Set it to off to turn AI inside generated apps
# off entirely (no AI mode, and the relays refuse calls from apps deployed
# earlier). Blank = they use the provider from STEP 1.
# Baked in at build time: with Docker, re-run `docker compose up --build` after
# changing it.
APPBLIPS_GENERATED_AI_MODE=

# URL that generated apps call for AI. Blank = /api/app-ai/chat on this
# AppBlips (exported apps get it as a full address automatically). Change it
# only if the relay lives at a different address. Baked in at build time.
APPBLIPS_APP_AI_RELAY_URL=

# Who may call the generated-app AI endpoint. Same-origin callers are always
# allowed. List other origins, comma-separated and exact. Only add `null` if
# you knowingly want local file:// apps to use it.
APPBLIPS_APP_AI_ALLOWED_ORIGINS=

# Limits for AI inside generated apps (separate from the builder). Blank =
# 4096 tokens, temperature 0.2, reasoning off.
APPBLIPS_APP_AI_MAX_TOKENS=
APPBLIPS_APP_AI_TEMPERATURE=
APPBLIPS_APP_AI_REASONING_EFFORT=none



# ── Analytics, branding and SEO (optional) ──────────────────────────────────
# Public origin used for canonical/Open Graph URLs and the sitemap. Blank =
# noindex (personal copies stay out of search engines).
VITE_SITE_URL=

# Optional Umami analytics for the platform and deployed apps. Blank = off.
VITE_UMAMI_SCRIPT_URL=
VITE_UMAMI_WEBSITE_ID=
VITE_UMAMI_RECORDER_URL=

# Per-deployment opt-in analytics script src. Blank = per-app analytics off.
VITE_APP_UMAMI_SCRIPT_URL=

# "Remix Blip!" badge link on deployed apps. Blank = no badge.
VITE_REMIX_URL=

# Per-deployment Umami admin API (used to create/query per-app sites).
UMAMI_API_URL=
# [secret]
UMAMI_ADMIN_USERNAME=
UMAMI_ADMIN_PASSWORD=


# ── Multi-user via Supabase ────────────────────────────────────────────────
# Turns on sign-in, cloud project sync, public deploys and the gallery.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# [secret] Usage counters only; leave blank if you don't need them.
SUPABASE_SERVICE_ROLE_KEY=


# ── Stripe Billing (requires Supabase) ──────────────────────────────────────
# [secret] Stripe live or test secret key
STRIPE_SECRET_KEY=
# [secret] Stripe webhook signing secret (whsec_...)
STRIPE_WEBHOOK_SECRET=


# ── Debug ───────────────────────────────────────────────────────────────────
# PIN that unlocks the hidden raw-LLM-log panel (Ctrl/Cmd+Shift+D). Blank
# disables the feature. Wrong guesses are limited per IP (default 5 per 300s).
APPBLIPS_DEBUG_PIN=
APPBLIPS_DEBUG_PIN_RATE_LIMIT_MAX=
APPBLIPS_DEBUG_PIN_RATE_LIMIT_WINDOW_SECONDS=

# Note: a single-user AppBlips is meant to run on your own computer. It has no
# sign-in, and /api/chat and /api/app-ai/chat perform no authentication, so
# anyone who can reach them can spend your API key. Keep them on localhost, or
# put your own access control in front if other devices can reach them.
