# ── Required ────────────────────────────────────────────────────────────────
APPBLIPS_LLM_BASE_URL=https://api.openai.com/v1
APPBLIPS_LLM_API_KEY=
APPBLIPS_LLM_MODEL=gpt-4o
APPBLIPS_LLM_MAX_TOKENS=
APPBLIPS_LLM_REASONING_EFFORT=none
# Optional: sampling temperature sent to the LLM. Defaults to 0.2.
APPBLIPS_LLM_TEMPERATURE=

# Optional per-user rate limit on /api/chat. Defaults: 60 requests / 300s.
APPBLIPS_CHAT_RATE_LIMIT_MAX=
APPBLIPS_CHAT_RATE_LIMIT_WINDOW_SECONDS=

# Optional per-deployment AI relay rate limit. Defaults: 20 requests / 60s.
APPBLIPS_AI_RATE_LIMIT_MAX=
APPBLIPS_AI_RATE_LIMIT_WINDOW_SECONDS=


# Optional: per-deployment analytics via a dedicated self-hosted Umami admin
# API (hosted mode only). Leave blank to disable the "Enable analytics"
# toggle in the Deploy modal and the analytics dashboard. Self-hosted Umami
# only supports username/password login, not long-lived API keys, so a real
# admin account is needed here (not a viewer-only one -- creating websites
# requires admin access).
UMAMI_API_URL=
UMAMI_ADMIN_USERNAME=
UMAMI_ADMIN_PASSWORD=

# Runs as a single local user with no sign-in, no cloud sync, and no
# deploy-to-public-URL feature. /api/chat doesn't authenticate requests, so
# don't expose it publicly without your own access control in front of it.
SELF_HOSTED_MODE=true
