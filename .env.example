# ── Required ────────────────────────────────────────────────────────────────
APPBLIPS_LLM_BASE_URL=https://api.openai.com/v1
APPBLIPS_LLM_API_KEY=
APPBLIPS_LLM_MODEL=gpt-4o
APPBLIPS_LLM_MAX_TOKENS=
# Optional: output token cap for Ask-mode chat replies only. Independent of
# APPBLIPS_LLM_MAX_TOKENS. Defaults to 8192 (headroom for reasoning tokens).
APPBLIPS_LLM_ASK_MAX_TOKENS=
# Reasoning effort for the builder is not set here -- each user chooses it in
# the app's Settings modal (Off / Low / Medium / High); it defaults to off.
# Optional: pin the LLM provider so the effort value is translated into the
# wire format that provider expects: openai (default), deepseek, or zai.
# When unset, the provider is auto-detected from APPBLIPS_LLM_MODEL and
# APPBLIPS_LLM_BASE_URL.
APPBLIPS_LLM_PROVIDER=
# Optional: sampling temperature sent to the LLM. Defaults to 0.2.
APPBLIPS_LLM_TEMPERATURE=

# Optional rate limit on /api/chat. Defaults: 60 requests / 300s.
APPBLIPS_CHAT_RATE_LIMIT_MAX=
APPBLIPS_CHAT_RATE_LIMIT_WINDOW_SECONDS=

# Runs as a single local user with no sign-in, no cloud sync, and no
# deploy-to-public-URL feature. /api/chat doesn't authenticate requests, so
# don't expose it publicly without your own access control in front of it.
SELF_HOSTED_MODE=true

# ── AI inside apps users generate ─────────────────────────────────────────
# How apps generated by this instance get their AI (blip.ai.text).
# byok (default): each person enters their own provider endpoint, model, and
# key in the finished app. relay: your server pays for and proxies app AI using
# the APPBLIPS_APP_LLM_* variables below.
APPBLIPS_GENERATED_AI_MODE=byok

# The settings below apply only when APPBLIPS_GENERATED_AI_MODE=relay. They are
# deliberately separate from the APPBLIPS_LLM_* variables above, which power
# the AppBlips builder itself.
APPBLIPS_APP_LLM_BASE_URL=https://api.openai.com/v1
APPBLIPS_APP_LLM_API_KEY=
APPBLIPS_APP_LLM_MODEL=gpt-4o
APPBLIPS_APP_LLM_MAX_TOKENS=
# Reasoning effort for generated-app AI calls (operator-set; users' Settings
# value does not apply here). Translated per provider like the builder.
APPBLIPS_APP_LLM_REASONING_EFFORT=none
# Optional: pin the generated-app AI provider (openai/deepseek/zai); auto-
# detected from APPBLIPS_APP_LLM_MODEL / APPBLIPS_APP_LLM_BASE_URL when unset.
APPBLIPS_APP_LLM_PROVIDER=
# Optional: sampling temperature for generated-app AI. Defaults to 0.2.
APPBLIPS_APP_LLM_TEMPERATURE=

# Public URL embedded in generated apps in relay mode. Use the same-origin
# route for apps served beside AppBlips, or an absolute HTTPS URL for apps
# hosted elsewhere. This is public configuration, never a secret.
APPBLIPS_APP_AI_RELAY_URL=/api/app-ai/chat

# Comma-separated exact origins allowed to call a cross-origin relay. A
# same-origin caller is allowed automatically. Only include `null` if you
# knowingly want local file:// apps to use your relay.
APPBLIPS_APP_AI_ALLOWED_ORIGINS=

# Optional relay rate limit per client IP. Defaults: 20 requests / 60s.
APPBLIPS_APP_AI_RATE_LIMIT_MAX=
APPBLIPS_APP_AI_RATE_LIMIT_WINDOW_SECONDS=

# Optional: public origin used for canonical/Open Graph URLs and the sitemap in
# hosted builds (SELF_HOSTED_MODE=false). Defaults to https://appblips.com.
VITE_SITE_URL=
