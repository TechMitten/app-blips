# ═════════════════════════════════════════════════════════════════════════════
#  AppBlips — configuration
#
#  Using the desktop app? You don't need this file: set your AI provider in
#  the app under Settings → AI.
#
#  1. Copy this file to .env
#  2. Fill in STEP 1 (an API key and a model) -- that is all a single-user
#     install needs.
#  3. Start the app. It prints which AI provider it found.
#
#  Everything else is optional. Blank lines mean "use the default".
#
#  This file only holds single-user settings, so a copy of it always starts
#  AppBlips in single-user mode.
#
#  AppBlips is designed as a single-user application: one local user, no sign-in.
#  Projects are saved locally in the browser. /api/chat performs no authentication,
#  so keep it on localhost or behind your own access control.
# ═════════════════════════════════════════════════════════════════════════════


# ── STEP 1 (required): your AI provider ─────────────────────────────────────
# Fill in your DeepSeek API key.
# Alternatively, leave STEP 1 blank and choose a provider, model and key in the
# app under Settings → AI (stored in your browser only).
OPENAI_API_KEY=

# The model to use, written exactly as your provider names it. For example:
#   deepseek-v4-pro
OPENAI_LLM_MODEL=deepseek-v4-pro


# ── STEP 2 (optional): limits and tuning ────────────────────────────────────
# Maximum length of one builder response, in tokens. Blank = provider default.
OPENAI_LLM_MAX_TOKENS=
# Sampling temperature for the builder. Blank = 0.2.
OPENAI_LLM_TEMPERATURE=
# /api/chat refuses browser requests from pages other than AppBlips itself.
# Only needed behind a reverse proxy that rewrites the Host header: list the
# address you open AppBlips at, comma-separated and exact.
APPBLIPS_CHAT_ALLOWED_ORIGINS=


# ── Advanced ────────────────────────────────────────────────────────────────
# The OPENAI_* names are the general settings for whichever OpenAI-compatible
# endpoint is active.
# OPENAI_API_KEY is also the fallback key for any provider.
# Any other OpenAI-compatible service (Ollama, vLLM, LiteLLM, Groq, ...):
# fill in the base URL here, plus STEP 1's OPENAI_API_KEY (Ollama needs none:
# put any text) and OPENAI_LLM_MODEL. On a named provider above, the base URL
# instead overrides that provider's default endpoint.
OPENAI_BASE_URL=

# Choose the provider explicitly when more than one key is filled in:
# openrouter or openai-compatible.
OPENAI_LLM_PROVIDER=

# How the provider expects the reasoning setting: reasoning_effort, reasoning,
# thinking or omit (send nothing). Blank = the provider's usual format.
OPENAI_LLM_REASONING_PARAM=
# Token cap for Ask-mode chat replies only. Blank = 8192.
OPENAI_LLM_ASK_MAX_TOKENS=
# Optional models for particular jobs, on the same provider and key. Blank =
# OPENAI_LLM_MODEL. VISION is used for any request with an attached image, so
# a text-only main model can still read screenshots.
OPENAI_LLM_VISION_MODEL=

# Note: a single-user AppBlips is meant to run on your own computer. It has no
# sign-in, and /api/chat performs no authentication, so anyone who can reach
# it can spend your API key. Keep it on localhost, or put your own access
# control in front if other devices can reach it.
