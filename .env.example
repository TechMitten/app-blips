# Settings for running AppBlips in a browser: `npm start`, `npm run dev`, or
# Docker. The desktop app doesn't read this file: set your AI provider there
# under Settings → AI.
#
# Everything here is optional. Copy this file to .env and fill in what you need.
# The easiest setup is to leave it empty and pick a provider, key and model in
# the app under Settings → AI. That works with every provider, including
# Anthropic; the key is kept by the server on this computer, not in the browser.

# ---- AI provider for the server ---------------------------------------------
# Used when Settings → AI has no provider. Works with DeepSeek (the default)
# or any service that speaks the OpenAI chat-completions API.
OPENAI_API_KEY=
OPENAI_LLM_MODEL=
# Blank means DeepSeek. Example: https://openrouter.ai/api/v1
OPENAI_BASE_URL=
# Optional: a model for requests with an attached image, on the same service.
OPENAI_LLM_VISION_MODEL=
# Optional: sampling temperature (default 0.2).
OPENAI_LLM_TEMPERATURE=

# ---- Server ------------------------------------------------------------------
# Port for `npm start` (default 3000). With Docker, set APPBLIPS_PORT instead.
PORT=
# Port Docker publishes on your computer (default 3000).
APPBLIPS_PORT=
# AppBlips only answers at localhost. To open it under another name (a reverse
# proxy's domain, say), list the names here, comma-separated. It has no
# sign-in: anyone who can reach it can spend the key above.
APPBLIPS_ALLOWED_HOSTS=
# Behind a reverse proxy that changes the Host header, list the exact address
# you open AppBlips at, e.g. https://appblips.example.com
APPBLIPS_CHAT_ALLOWED_ORIGINS=
# Folder for the API key you enter under Settings → AI in the browser version
# (it is kept here, readable only by you, not in the browser). Defaults to
# .appblips in your home folder; the Docker image uses /data.
APPBLIPS_DATA_DIR=

# Clerk publishable key (frontend auth, https://dashboard.clerk.com)
VITE_CLERK_PUBLISHABLE_KEY=

# Hosted multi-user mode (billing + plan-gated models). Leave unset for local use.
# APPBLIPS_HOSTED=1
# APPBLIPS_DB_PATH=appblips.db
# APPBLIPS_BILLING_SUCCESS_URL=
# CREEM_SERVER=prod            # or test
# CREEM_API_KEY=               # production key
# CREEM_WEBHOOK_SECRET=
# CREEM_PRODUCT_BASIC=
# CREEM_PRODUCT_SILVER=
# CREEM_PRODUCT_MAX=
# CREEM_TEST_API_KEY=          # sandbox key (test mode is isolated)
# CREEM_TEST_WEBHOOK_SECRET=
# CREEM_TEST_PRODUCT_BASIC=
# CREEM_TEST_PRODUCT_SILVER=
# CREEM_TEST_PRODUCT_MAX=
# Model aliases per tier: set the model id to run for each plan. Never shown to users.
# APPBLIPS_MODEL_BASIC=
# APPBLIPS_MODEL_SILVER=
# APPBLIPS_MODEL_MAX=

# ---- Per-user Render Sandbox computer (optional) -----------------------------
# Gives each user their own isolated Linux sandbox computer on Render
# (https://dashboard.render.com/u/settings?add-api-key). Sandboxes auto-sleep
# after 5 minutes of inactivity and wake on the next command.
# RENDER_API_KEY=rnd_...
# RENDER_WORKSPACE_ID=tea-...
# RENDER_SANDBOX_GROUP_ID=
# RENDER_SANDBOX_IMAGE=
# RENDER_SANDBOX_PLAN=
