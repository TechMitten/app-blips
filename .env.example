# ═════════════════════════════════════════════════════════════════════════════
#  AppBlips — self-hosted configuration
#
#  1. Copy this file to .env
#  2. Fill in STEP 1 below (an API key and a model) -- that is all you need.
#     Apps you build use that same provider and model for their own AI.
#  3. Start the app. It prints which AI provider it found.
#
#  Everything else is optional. Blank lines mean "use the default".
#
#  AppBlips is licensed under the Elastic License 2.0: run it for yourself or
#  inside your own organization, but not as a hosted service for other people
#  (see LICENSE). .env.hosted.example documents the official appblips.com
#  deployment and is not needed here.
# ═════════════════════════════════════════════════════════════════════════════


# ── STEP 1 (required): your AI provider ─────────────────────────────────────
# Fill in the API key for ONE provider. The provider whose key is filled in
# becomes active; leave the others blank.
APPBLIPS_OPENAI_API_KEY=
# OpenRouter gives you Claude, Gemini and most other models with one key.
APPBLIPS_OPENROUTER_API_KEY=
APPBLIPS_DEEPSEEK_API_KEY=
APPBLIPS_ZAI_API_KEY=

# The model to use, written exactly as your provider names it. For example:
#   OpenAI      gpt-5.1
#   OpenRouter  anthropic/claude-sonnet-5   or   google/gemini-3-pro
#   DeepSeek    deepseek-chat
#   Z.ai        glm-5.3-flash
APPBLIPS_LLM_MODEL=


# ── STEP 2 (optional): limits and tuning ────────────────────────────────────
# Maximum length of one builder response, in tokens. Blank = provider default.
APPBLIPS_LLM_MAX_TOKENS=
# Sampling temperature for the builder. Blank = 0.2.
APPBLIPS_LLM_TEMPERATURE=
# Requests allowed per window on /api/chat. Blank = 60 per 300 seconds.
APPBLIPS_CHAT_RATE_LIMIT_MAX=
APPBLIPS_CHAT_RATE_LIMIT_WINDOW_SECONDS=


# ── Advanced ────────────────────────────────────────────────────────────────
# Any other OpenAI-compatible service (Ollama, vLLM, LiteLLM, Groq, ...):
# fill in the base URL, an API key (Ollama needs none: put any text) and the
# model in STEP 1's APPBLIPS_LLM_MODEL. On a named provider above, the base URL
# instead overrides that provider's default endpoint.
APPBLIPS_LLM_BASE_URL=
APPBLIPS_LLM_API_KEY=

# Choose the provider explicitly when more than one key is filled in:
# openai, openrouter, deepseek, zai or openai-compatible.
APPBLIPS_LLM_PROVIDER=

# How the provider expects the reasoning setting: reasoning_effort, reasoning,
# thinking or omit (send nothing). Blank = the provider's usual format.
APPBLIPS_LLM_REASONING_PARAM=
# Token cap for Ask-mode chat replies only. Blank = 8192.
APPBLIPS_LLM_ASK_MAX_TOKENS=

# Prefer that each person using a finished app brings their own key instead of
# using yours? Set this to byok. Blank = they use the provider from STEP 1.
# Baked in at build time: with Docker, re-run `docker compose up --build` after
# changing it.
APPBLIPS_GENERATED_AI_MODE=

# Apps you generate that use blip.ai.text(...) always use the same provider,
# key and model as STEP 1 -- there is nothing to set up for them. Only their
# limits are separate. Blank = 4096 tokens, temperature 0.2, reasoning off.
APPBLIPS_APP_AI_MAX_TOKENS=
APPBLIPS_APP_AI_TEMPERATURE=
APPBLIPS_APP_AI_REASONING_EFFORT=none

# URL that generated apps call for AI. Blank = /api/app-ai/chat on this
# AppBlips (exported apps get it as a full address automatically). Change it
# only if the relay lives at a different address. Baked in at build time.
APPBLIPS_APP_AI_RELAY_URL=

# Who may call the generated-app AI endpoint. Same-origin callers are always
# allowed.
# List other origins, comma-separated and exact. Only add `null` if you
# knowingly want local file:// apps to use it.
APPBLIPS_APP_AI_ALLOWED_ORIGINS=
# Rate limit per client IP. Blank = 20 requests per 60 seconds.
APPBLIPS_APP_AI_RATE_LIMIT_MAX=
APPBLIPS_APP_AI_RATE_LIMIT_WINDOW_SECONDS=

# PIN that unlocks the hidden raw-LLM-log panel (Ctrl/Cmd+Shift+D). Blank
# disables the feature. Wrong guesses are limited per IP (default 5 per 300s).
APPBLIPS_DEBUG_PIN=
APPBLIPS_DEBUG_PIN_RATE_LIMIT_MAX=
APPBLIPS_DEBUG_PIN_RATE_LIMIT_WINDOW_SECONDS=

# Note: self-hosted AppBlips is meant to run on your own computer. It has no
# sign-in, and /api/chat and /api/app-ai/chat perform no authentication, so
# anyone who can reach them can spend your API key. Keep them on localhost, or
# put your own access control in front if other devices can reach them.
