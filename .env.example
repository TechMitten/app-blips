# ── Required ────────────────────────────────────────────────────────────────
APPBLIPS_LLM_BASE_URL=https://api.openai.com/v1
APPBLIPS_LLM_API_KEY=
APPBLIPS_LLM_MODEL=gpt-4o
APPBLIPS_LLM_MAX_TOKENS=
APPBLIPS_LLM_REASONING_EFFORT=none
# Optional: sampling temperature sent to the LLM. Defaults to 0.2.
APPBLIPS_LLM_TEMPERATURE=

# Optional per-user rate limit on /api/chat. Defaults: 60 requests / 300s.
APPBLIPS_CHAT_RATE_LIMIT_MAX=
APPBLIPS_CHAT_RATE_LIMIT_WINDOW_SECONDS=

# Optional per-deployment AI relay rate limit. Defaults: 20 requests / 60s.
APPBLIPS_AI_RATE_LIMIT_MAX=
APPBLIPS_AI_RATE_LIMIT_WINDOW_SECONDS=

# ── AI inside apps users generate ─────────────────────────────────────────
# These server-side credentials power generated-app AI (blip.ai.text) in BOTH
# hosted mode (functions/_lib/aiRelay.js) and self-hosted relay mode
# (functions/_lib/selfHostedAiRelay.js). They are deliberately separate from
# the APPBLIPS_LLM_* variables above, which power the AppBlips builder itself.
APPBLIPS_APP_LLM_BASE_URL=https://api.openai.com/v1
APPBLIPS_APP_LLM_API_KEY=
APPBLIPS_APP_LLM_MODEL=gpt-4o
APPBLIPS_APP_LLM_MAX_TOKENS=
APPBLIPS_APP_LLM_REASONING_EFFORT=none
# Optional: sampling temperature for generated-app AI. Defaults to 0.2.
APPBLIPS_APP_LLM_TEMPERATURE=

# Self-hosted only: how apps generated by this instance get their AI.
# byok (default): each person enters their own provider endpoint, model, and
# key in the finished app. relay: your server pays for and proxies app AI using
# the APPBLIPS_APP_LLM_* variables above.
APPBLIPS_GENERATED_AI_MODE=byok

# Public URL embedded in generated apps when self-hosted relay mode is selected.
# Use the same-origin route for apps served beside AppBlips, or an absolute
# HTTPS URL for apps hosted elsewhere. This is public configuration, never a
# secret. Hosted mode ignores this and uses the same-origin /ai/chat route.
APPBLIPS_APP_AI_RELAY_URL=/api/app-ai/chat

# Comma-separated exact origins allowed to call a cross-origin relay. A
# same-origin caller is allowed automatically. Only include `null` if you
# knowingly want local file:// apps to use your relay.
APPBLIPS_APP_AI_ALLOWED_ORIGINS=

# Optional relay rate limit per client IP. Defaults: 20 requests / 60s.
APPBLIPS_APP_AI_RATE_LIMIT_MAX=
APPBLIPS_APP_AI_RATE_LIMIT_WINDOW_SECONDS=


# Optional: per-deployment analytics via a dedicated self-hosted Umami admin
# API (hosted mode only). Leave blank to disable the "Enable analytics"
# toggle in the Deploy modal and the analytics dashboard. Self-hosted Umami
# only supports username/password login, not long-lived API keys, so a real
# admin account is needed here (not a viewer-only one -- creating websites
# requires admin access).
UMAMI_API_URL=
UMAMI_ADMIN_USERNAME=
UMAMI_ADMIN_PASSWORD=

# Runs as a single local user with no sign-in, no cloud sync, and no
# deploy-to-public-URL feature. /api/chat doesn't authenticate requests, so
# don't expose it publicly without your own access control in front of it.
# Set to "false" for hosted mode (Firebase Auth + Firestore + Storage) -- see
# the Firebase section below, which is required only when this is "false".
SELF_HOSTED_MODE=true

# ── Firebase (hosted mode only -- leave unset for self-hosting) ────────────
# Required client config when SELF_HOSTED_MODE=false (from your Firebase
# project's web app settings). Vite only inlines VITE_-prefixed vars into the
# client bundle, so these must keep the prefix.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Required server-side in hosted mode: verifies Firebase ID tokens against
# the accounts:lookup REST endpoint on every /api/chat call. Mark this
# Secret in your host's environment variable settings.
FIREBASE_API_KEY=

# Optional in hosted mode: used to validate the App Check token audience/
# issuer more strictly. Falls back to VITE_FIREBASE_PROJECT_ID if unset.
FIREBASE_PROJECT_NUMBER=

# Optional: set to false to skip App Check verification on /api/chat
# (enforced by default whenever SELF_HOSTED_MODE=false).
FIREBASE_APPCHECK_ENFORCE=true

# Optional: enables Firebase App Check in local dev against a hosted Firebase
# project, using reCAPTCHA Enterprise. Leave unset if you don't need App
# Check locally.
VITE_FIREBASE_RECAPTCHA_SITE_KEY=
# Optional: static App Check debug token for local development in hosted
# mode (register it in the Firebase console under App Check > Debug tokens).
VITE_FIREBASE_APPCHECK_DEBUG_TOKEN=
