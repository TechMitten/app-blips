# ═════════════════════════════════════════════════════════════════════════════
#  AppBlips — configuration
#
#  Using the desktop app? You don't need this file: set your AI provider in
#  the app under Settings → AI.
#
#  1. Copy this file to .env
#  2. Fill in STEP 1 (an API key and a model) -- that is all a single-user
#     install needs.
#  3. Start the app. It prints which AI provider it found.
#
#  Everything else is optional. Blank lines mean "use the default".
#
#  AppBlips is designed as a single-user application: one local user, no sign-in.
#  Projects are saved locally in the browser. /api/chat performs no authentication,
#  so keep it on localhost or behind your own access control.
# ═════════════════════════════════════════════════════════════════════════════


# ── STEP 1 (required): your AI provider ─────────────────────────────────────
# Fill in your DeepSeek API key.
# Alternatively, leave STEP 1 blank and choose a provider, model and key in the
# app under Settings → AI (stored in your browser only).
OPENAI_API_KEY=

# The model to use, written exactly as your provider names it. For example:
#   deepseek-v4-pro
OPENAI_LLM_MODEL=deepseek-v4-pro


# ── STEP 2 (optional): limits and tuning ────────────────────────────────────
# Maximum length of one builder response, in tokens. Blank = provider default.
OPENAI_LLM_MAX_TOKENS=
# Sampling temperature for the builder. Blank = 0.2.
OPENAI_LLM_TEMPERATURE=
# /api/chat refuses browser requests from pages other than AppBlips itself.
# Only needed behind a reverse proxy that rewrites the Host header: list the
# address you open AppBlips at, comma-separated and exact.
APPBLIPS_CHAT_ALLOWED_ORIGINS=


# ── Advanced ────────────────────────────────────────────────────────────────
# The OPENAI_* names are the general settings for whichever OpenAI-compatible
# endpoint is active. The older APPBLIPS_LLM_* names (APPBLIPS_LLM_MODEL,
# APPBLIPS_LLM_MAX_TOKENS, ...) still work as a fallback, and the server
# prints a rename reminder at startup when it sees them.
# OPENAI_API_KEY is also the fallback key for any provider.
# Any other OpenAI-compatible service (Ollama, vLLM, LiteLLM, Groq, ...):
# fill in the base URL, an API key (Ollama needs none: put any text) and the
# model in STEP 1's OPENAI_LLM_MODEL. On a named provider above, the base URL
# instead overrides that provider's default endpoint.
OPENAI_BASE_URL=
OPENAI_API_KEY=

# Choose the provider explicitly when more than one key is filled in:
# openrouter or openai-compatible.
OPENAI_LLM_PROVIDER=

# How the provider expects the reasoning setting: reasoning_effort, reasoning,
# thinking or omit (send nothing). Blank = the provider's usual format.
OPENAI_LLM_REASONING_PARAM=
# Token cap for Ask-mode chat replies only. Blank = 8192.
OPENAI_LLM_ASK_MAX_TOKENS=
# Optional models for particular jobs, on the same provider and key. Blank =
# OPENAI_LLM_MODEL. VISION is used for any request with an attached image, so
# a text-only main model can still read screenshots.
OPENAI_LLM_VISION_MODEL=



# ── Maintenance ─────────────────────────────────────────────────────────────
# Set to true to pause building, Ask and upgrades for everyone, with a notice
# in the prompt box. Projects, sign-in and deployed apps keep working. To stop
# new accounts too, also untick "Enable create (sign-up)" in the Firebase
# console (Authentication -> Settings -> User actions); the sign-in screen
# then says so.
# Baked in at build time: redeploy (or rebuild) after changing it.
APPBLIPS_MAINTENANCE=

# ── Analytics, branding and SEO (optional) ──────────────────────────────────
# Public origin used for canonical/Open Graph URLs and the sitemap. Blank =
# noindex (personal copies stay out of search engines).
VITE_SITE_URL=

# Optional Umami analytics for the platform and deployed apps. Blank = off.
VITE_UMAMI_SCRIPT_URL=
VITE_UMAMI_WEBSITE_ID=
VITE_UMAMI_RECORDER_URL=

# Per-deployment opt-in analytics script src. Blank = per-app analytics off.
VITE_APP_UMAMI_SCRIPT_URL=

# "Remix Blip!" badge link on deployed apps. Blank = no badge.
VITE_REMIX_URL=

# Per-deployment Umami admin API (used to create/query per-app sites).
UMAMI_API_URL=
# [secret]
UMAMI_ADMIN_USERNAME=
UMAMI_ADMIN_PASSWORD=


# ── Multi-user via Firebase ────────────────────────────────────────────────
# Turns on Google/GitHub sign-in, cloud project sync and public deploys. The
# VITE_FIREBASE_* values are the public web-app config (Firebase console ->
# Project settings -> Your apps); set all four or none. Access is enforced by
# firestore.rules (deploy with `firebase deploy --only firestore`) and the
# server, not by keeping these secret. The desktop app ignores them: it is
# always single-user.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Server side. Blank = VITE_FIREBASE_PROJECT_ID. Used to verify ID tokens.
FIREBASE_PROJECT_ID=
# [secret] Service account key JSON (raw, or base64 of it), from Project
# settings -> Service accounts -> Generate new private key. Needed for
# deploys, billing, usage counters and account deletion.
FIREBASE_SERVICE_ACCOUNT=

# ── Deployed apps (Cloudflare R2) ───────────────────────────────────────────
# Where published apps are stored; served on VITE_APPS_ORIGIN by
# functions/[[path]].js. Create a private bucket and an R2 API token with
# Object Read & Write on it (R2 -> Manage API tokens).
R2_ACCOUNT_ID=
# [secret]
R2_ACCESS_KEY_ID=
# [secret]
R2_SECRET_ACCESS_KEY=
# Blank = orion-deploys
R2_BUCKET=
# The separate origin deployed apps are served on (never the studio's own
# origin: generated code there could read users' sessions), e.g.
# https://my.appblips.com. Blank = deploys off.
VITE_APPS_ORIGIN=


# ── Hosted multi-user settings ──────────────────────────────────────────────
# [secret] Random string that signs the Free plan's per-prompt passes (any
# long random value, e.g. `openssl rand -hex 32`). Blank = every model request
# counts as a new prompt.
APPBLIPS_SESSION_SECRET=
# Per-account /api/chat rate limit. Blank = 60 requests per 300 seconds.
APPBLIPS_CHAT_RATE_LIMIT_MAX=
APPBLIPS_CHAT_RATE_LIMIT_WINDOW_SECONDS=


# ── Stripe Billing (requires Firebase + FIREBASE_SERVICE_ACCOUNT) ───────────
# [secret] Stripe live or test secret key
STRIPE_SECRET_KEY=
# [secret] Stripe webhook signing secret (whsec_...)
STRIPE_WEBHOOK_SECRET=
# Where Stripe sends people back after checkout. Blank = the address the
# request came in on.
APPBLIPS_APP_URL=
# Comma-separated emails or account ids. When set, billing applies only to
# these accounts (for testing on the live site); blank = everyone.
APPBLIPS_BILLING_TESTERS=

# Note: a single-user AppBlips is meant to run on your own computer. It has no
# sign-in, and /api/chat performs no authentication, so anyone who can reach
# it can spend your API key. Keep it on localhost, or put your own access
# control in front if other devices can reach it.
