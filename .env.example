# Settings for running AppBlips in a browser: `npm start`, `npm run dev`, or
# Docker. The desktop app doesn't read this file: set your AI provider there
# under Settings → API.
#
# Everything here is optional. Copy this file to .env and fill in what you need.
# The easiest setup is to leave it empty and pick a provider, key and model in
# the app under Settings → API. That works with every provider, including
# Anthropic; the key is kept by the server on this computer, not in the browser.

# ---- AI provider for the server ---------------------------------------------
# Used when Settings → API has no provider. Works with DeepSeek (the default)
# or any service that speaks the OpenAI chat-completions API.
OPENAI_API_KEY=
OPENAI_LLM_MODEL=
# Blank means DeepSeek. Examples:
#   https://openrouter.ai/api/v1
#   http://localhost:11434/v1          (Ollama, from source)
#   http://host.docker.internal:11434/v1  (Ollama, from Docker)
OPENAI_BASE_URL=
# Optional: a model for requests with an attached image, on the same service.
OPENAI_LLM_VISION_MODEL=
# Optional: sampling temperature (default 0.2).
OPENAI_LLM_TEMPERATURE=

# ---- AppBlips AI Credits (optional) -------------------------------------------
# Most people leave these blank: connected credits are relayed through
# appblips.com. With both set, this server checks balances in Polar and calls
# DeepSeek itself. The Polar token needs orders:read too (paid months of the
# trial's $10/month plan add credits).
POLAR_TOKEN=
DEEPSEEK_API_KEY=
# Optional ready-made Polar checkout links, one per pack.
POLAR_CHECKOUT_URL_STARTER=
POLAR_CHECKOUT_URL_BUILDER=
POLAR_CHECKOUT_URL_STUDIO=
# Optional: the Polar organization that sends sign-in codes. Looked up from the
# trial product when blank (needs products:read on POLAR_TOKEN).
POLAR_ORGANIZATION_ID=
# Where credit requests go when POLAR_TOKEN is blank (default https://appblips.com).
APPBLIPS_CREDITS_ORIGIN=

# ---- Server ------------------------------------------------------------------
# Port for `npm start` (default 3000). With Docker, set APPBLIPS_PORT instead.
PORT=
# Port Docker publishes on your computer (default 3000).
APPBLIPS_PORT=
# AppBlips only answers at localhost. To open it under another name (a reverse
# proxy's domain, say), list the names here, comma-separated. It has no
# sign-in: anyone who can reach it can spend the key above.
APPBLIPS_ALLOWED_HOSTS=
# Behind a reverse proxy that changes the Host header, list the exact address
# you open AppBlips at, e.g. https://appblips.example.com
APPBLIPS_CHAT_ALLOWED_ORIGINS=
# Folder for the API key you enter under Settings → API in the browser version
# (it is kept here, readable only by you, not in the browser). Defaults to
# .appblips in your home folder; the Docker image uses /data.
APPBLIPS_DATA_DIR=
