# ═════════════════════════════════════════════════════════════════════════════
#  AppBlips — hosted multi-user settings (operators only)
#
#  These turn a copy of AppBlips into the hosted service: Google/GitHub
#  sign-in, cloud projects, public deploys and billing. Running your own copy
#  for yourself? You don't need any of this: use the desktop app, or
#  .env.example for a single-user install.
#
#  To use them, add the ones you need to your .env below the .env.example
#  settings. Filling in the Firebase project switches the server to
#  multi-user mode, where every /api/chat call must carry a signed-in user.
# ═════════════════════════════════════════════════════════════════════════════


# ── Maintenance ─────────────────────────────────────────────────────────────
# Set to true to pause building, Ask and upgrades for everyone, with a notice
# in the prompt box. Projects, sign-in and deployed apps keep working. To stop
# new accounts too, also untick "Enable create (sign-up)" in the Firebase
# console (Authentication -> Settings -> User actions); the sign-in screen
# then says so.
# Baked in at build time: redeploy (or rebuild) after changing it.
APPBLIPS_MAINTENANCE=

# ── Analytics, branding and SEO (optional) ──────────────────────────────────
# Public origin used for canonical/Open Graph URLs and the sitemap. Blank =
# noindex (personal copies stay out of search engines).
VITE_SITE_URL=

# Optional Umami analytics for the platform and deployed apps. Blank = off.
VITE_UMAMI_SCRIPT_URL=
VITE_UMAMI_WEBSITE_ID=
VITE_UMAMI_RECORDER_URL=

# Per-deployment opt-in analytics script src. Blank = per-app analytics off.
VITE_APP_UMAMI_SCRIPT_URL=

# "Remix Blip!" badge link on deployed apps. Blank = no badge.
VITE_REMIX_URL=

# Per-deployment Umami admin API (used to create/query per-app sites).
UMAMI_API_URL=
# [secret]
UMAMI_ADMIN_USERNAME=
UMAMI_ADMIN_PASSWORD=


# ── Multi-user via Firebase ────────────────────────────────────────────────
# Turns on Google/GitHub sign-in, cloud project sync and public deploys. The
# VITE_FIREBASE_* values are the public web-app config (Firebase console ->
# Project settings -> Your apps); set all four or none. Access is enforced by
# firestore.rules (deploy with `firebase deploy --only firestore`) and the
# server, not by keeping these secret. The desktop app ignores them: it is
# always single-user.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Server side. Blank = VITE_FIREBASE_PROJECT_ID. Used to verify ID tokens.
FIREBASE_PROJECT_ID=
# [secret] Service account key JSON (raw, or base64 of it), from Project
# settings -> Service accounts -> Generate new private key. Needed for
# deploys, billing, usage counters and account deletion.
FIREBASE_SERVICE_ACCOUNT=

# ── Deployed apps (Cloudflare R2) ───────────────────────────────────────────
# Where published apps are stored; served on VITE_APPS_ORIGIN by
# functions/[[path]].js. Create a private bucket and an R2 API token with
# Object Read & Write on it (R2 -> Manage API tokens).
R2_ACCOUNT_ID=
# [secret]
R2_ACCESS_KEY_ID=
# [secret]
R2_SECRET_ACCESS_KEY=
# Blank = orion-deploys
R2_BUCKET=
# The separate origin deployed apps are served on (never the studio's own
# origin: generated code there could read users' sessions), e.g.
# https://my.appblips.com. Blank = deploys off.
VITE_APPS_ORIGIN=


# ── Hosted multi-user settings ──────────────────────────────────────────────
# [secret] Random string that signs the Free plan's per-prompt passes (any
# long random value, e.g. `openssl rand -hex 32`). Blank = every model request
# counts as a new prompt.
APPBLIPS_SESSION_SECRET=
# Per-account /api/chat rate limit. Blank = 60 requests per 300 seconds.
APPBLIPS_CHAT_RATE_LIMIT_MAX=
APPBLIPS_CHAT_RATE_LIMIT_WINDOW_SECONDS=


# ── Stripe Billing (requires Firebase + FIREBASE_SERVICE_ACCOUNT) ───────────
# [secret] Stripe live or test secret key
STRIPE_SECRET_KEY=
# [secret] Stripe webhook signing secret (whsec_...)
STRIPE_WEBHOOK_SECRET=
# Where Stripe sends people back after checkout. Blank = the address the
# request came in on.
APPBLIPS_APP_URL=
# Comma-separated emails or account ids. When set, billing applies only to
# these accounts (for testing on the live site); blank = everyone.
APPBLIPS_BILLING_TESTERS=
