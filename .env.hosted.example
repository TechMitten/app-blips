# ═════════════════════════════════════════════════════════════════════════════
#  AppBlips — hosted configuration (Firebase sign-in, cloud projects, deploys)
#
#  Maintainer reference for the official appblips.com deployment. It lists
#  every variable the hosted build reads, so the Cloudflare Pages dashboard can
#  be checked against it.
#
#  The Elastic License 2.0 does not permit offering AppBlips to third parties
#  as a hosted or managed service (see LICENSE). Running it for yourself? Use
#  .env.example instead.
#
#  MINIMUM YOU NEED
#    - SELF_HOSTED_MODE=false                       (section 1)
#    - the Firebase values                          (sections 2 and 3)
#    - one AI provider key and a model              (section 4)
#
#  WHERE THIS GOES
#    - Local development: copy this file to .env.
#    - Production (Cloudflare Pages): add the same names under
#      Settings -> Environment variables. Mark every [secret] as a Secret.
#
#  WHEN EACH VARIABLE IS READ
#    [build]    baked into the client bundle at build time. Public by design.
#               Changing one needs a rebuild/redeploy.
#    [runtime]  read by the server on every request. Changing one needs only a
#               redeploy or restart.
#    [secret]   a [runtime] value that must never be public. Never give a
#               secret a VITE_ prefix.
#
#  On startup (`npm run dev`) AppBlips prints which provider is active and
#  which of the values below are still empty.
# ═════════════════════════════════════════════════════════════════════════════


# ── 1. Mode ─────────────────────────────────────────────────────────────────
# [build + runtime] Turns on Firebase sign-in, cloud projects and deploys.
SELF_HOSTED_MODE=false


# ── 2. Firebase project, client side ────────────────────────────────────────
# [build] Firebase console -> Project settings -> Your apps -> Web app.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# reCAPTCHA Enterprise site key for App Check.
VITE_FIREBASE_RECAPTCHA_SITE_KEY=
VITE_FIREBASE_PROJECT_NUMBER=
# Local development only: an App Check debug token (never set in production).
VITE_FIREBASE_APPCHECK_DEBUG_TOKEN=


# ── 3. Firebase project, server side ────────────────────────────────────────
# [runtime] The same web API key as above; the server uses it to verify sign-in
# tokens. It is public by nature, so restrict it in Google Cloud Console.
FIREBASE_API_KEY=
# [runtime] Used to verify App Check tokens.
FIREBASE_PROJECT_NUMBER=
# [runtime] Blank = App Check is enforced. Set to false only to turn it off
# (for example in local development).
FIREBASE_APPCHECK_ENFORCE=
# [runtime] Optional server-side overrides. Blank = the VITE_FIREBASE_PROJECT_ID
# and VITE_FIREBASE_APP_ID values above. Set them only if the server does not
# have the VITE_ values available.
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=
# [secret] App Check debug token the server exchanges for an App Check token
# so it can read Firestore when serving deployed apps and validating
# deployed-app AI. Register it in Firebase console -> App Check -> Apps ->
# Manage debug tokens. Required in production.
FIREBASE_APPCHECK_DEBUG_TOKEN=


# ── 4. AI provider for the builder ──────────────────────────────────────────
# [secret] Fill in the API key for ONE provider; the one whose key is filled in
# becomes active. OpenRouter gives you Claude, Gemini and most other models.
APPBLIPS_OPENAI_API_KEY=
APPBLIPS_OPENROUTER_API_KEY=
APPBLIPS_DEEPSEEK_API_KEY=
APPBLIPS_ZAI_API_KEY=
# [runtime] The model, exactly as the provider names it, for example
# anthropic/claude-sonnet-5 or google/gemini-3-pro on OpenRouter.
APPBLIPS_LLM_MODEL=
# [runtime] Choose explicitly if more than one key is filled in: openai,
# openrouter, deepseek, zai or openai-compatible. Blank = the first key found.
APPBLIPS_LLM_PROVIDER=
# [runtime] Any other OpenAI-compatible service: fill in these two instead of a
# named provider's key. On a named provider the base URL overrides its default
# endpoint.
APPBLIPS_LLM_BASE_URL=
APPBLIPS_LLM_API_KEY=
# [runtime] Builder response length and sampling. Blank = provider default,
# and 0.2 for temperature.
APPBLIPS_LLM_MAX_TOKENS=
APPBLIPS_LLM_TEMPERATURE=
# [runtime] Token cap for Ask-mode replies only. Blank = 8192.
APPBLIPS_LLM_ASK_MAX_TOKENS=
# [runtime] How the provider expects the reasoning setting: reasoning_effort,
# reasoning, thinking or omit. Blank = the provider's usual format.
APPBLIPS_LLM_REASONING_PARAM=
# [runtime] Builder request limits per signed-in user. Blank = 60 requests per
# 300 seconds, at most 100 messages and 2 MB per request.
APPBLIPS_CHAT_RATE_LIMIT_MAX=
APPBLIPS_CHAT_RATE_LIMIT_WINDOW_SECONDS=
APPBLIPS_CHAT_MAX_MESSAGES=
APPBLIPS_CHAT_MAX_BODY_BYTES=


# ── 5. AI inside deployed apps ──────────────────────────────────────────────
# Deployed apps that use blip.ai.text(...) call this server's /ai/chat.
#
# They always use the SAME provider, key, endpoint and model as section 4;
# there is no separate key to set. Anyone who opens a deployed app spends that
# key, so keep the limits and abuse controls below in place and set a spend
# cap with the provider.
#
# [runtime] Deployed-app AI limits (separate from the builder's). Blank = 4096
# tokens, temperature 0.2, reasoning off.
APPBLIPS_APP_AI_MAX_TOKENS=
APPBLIPS_APP_AI_TEMPERATURE=
APPBLIPS_APP_AI_REASONING_EFFORT=none

# Abuse controls for deployed apps. Without sessions, each deployment embeds a
# token that is valid until the next redeploy. Sessions replace it with
# short-lived signed tokens, so a copied page stops working when it expires.
# [secret] Signing secret for sessions (a long random string). Setting it and
# VITE_AI_SESSION_ENABLED=true together turns sessions on.
APPBLIPS_SESSION_SECRET=
# [build] true = deployed apps request short-lived sessions.
VITE_AI_SESSION_ENABLED=
# [runtime] Session lifetime in seconds. Blank = the built-in default.
APPBLIPS_AI_SESSION_TTL_SECONDS=
# [runtime] true = refuse requests without a valid session token.
APPBLIPS_AI_REQUIRE_SESSION=
# [runtime] Blank or true = requests must carry the deployment's own Origin.
# Set to false only if you have a reason to accept requests without one.
APPBLIPS_AI_REQUIRE_ORIGIN=
# Cloudflare Turnstile gates who can mint a session -- this is what actually
# blocks scripted clients, since Origin can be faked.
# [secret] Turnstile secret key.
TURNSTILE_SECRET=
# [build] Turnstile site key (public).
VITE_AI_TURNSTILE_SITE_KEY=
# [runtime] Rate limits, best effort per server instance. Per client IP
# (blank = 20 per 60s) and per deployment, across all visitors (blank = 120
# per 60s).
APPBLIPS_AI_RATE_LIMIT_MAX=
APPBLIPS_AI_RATE_LIMIT_WINDOW_SECONDS=
APPBLIPS_AI_DEPLOYMENT_RATE_LIMIT_MAX=
APPBLIPS_AI_DEPLOYMENT_RATE_LIMIT_WINDOW_SECONDS=


# ── 6. Analytics (optional) ─────────────────────────────────────────────────
# [runtime] Per-deployment Umami analytics, from your own Umami instance.
UMAMI_API_URL=
# [secret]
UMAMI_ADMIN_USERNAME=
UMAMI_ADMIN_PASSWORD=


# ── 7. Site and extras (optional) ───────────────────────────────────────────
# [build] Public origin used for canonical/Open Graph URLs and the sitemap.
# Blank = https://appblips.com.
VITE_SITE_URL=
# [secret] PIN for the hidden raw-LLM-log panel (Ctrl/Cmd+Shift+D). Blank
# disables the feature. Wrong guesses are limited per IP (default 5 per 300s).
APPBLIPS_DEBUG_PIN=
APPBLIPS_DEBUG_PIN_RATE_LIMIT_MAX=
APPBLIPS_DEBUG_PIN_RATE_LIMIT_WINDOW_SECONDS=
