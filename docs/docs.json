{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "almond",
  "name": "AppBlips",
  "colors": {
    "primary": "#080808",
    "light": "#58b9ea",
    "dark": "#ed7a77"
  },
  "favicon": "/favicon.png",
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Get Started",
            "pages": [
              "introduction",
              "quickstart-desktop"
            ]
          },
          {
            "group": "Core Features",
            "pages": [
              "features/building-apps",
              "features/live-preview",
              "features/editing-apps",
              "features/exporting",
              "features/importing-sites"
            ]
          },
          {
            "group": "Advanced",
            "pages": [
              "self-hosting/security"
            ]
          },
          {
            "group": "Reference",
            "pages": [
              "reference/settings",
              "reference/faq",
              "reference/troubleshooting",
              "reference/code-signing-policy"
            ]
          }
        ]
      }
    ]
  },
  "navbar": {
    "links": [
      {
        "label": "GitHub",
        "href": "https://github.com/techmitten/app-blips"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Download",
      "href": "https://github.com/TechMitten/app-blips/releases"
    }
  },
  "description": "Documentation for AppBlips, a desktop app that turns plain English into working apps, websites and games, with a live preview and export.",
  "logo": {
    "light": "/logo-light.png",
    "dark": "/logo-dark.png"
  },
  "redirects": [
    {
      "source": "/quickstart-self-hosted",
      "destination": "/quickstart-desktop"
    },
    {
      "source": "/self-hosting/docker",
      "destination": "/quickstart-desktop"
    },
    {
      "source": "/self-hosting/configuration",
      "destination": "/quickstart-desktop"
    },
    {
      "source": "/pricing",
      "destination": "/quickstart-desktop"
    }
  ]
}
