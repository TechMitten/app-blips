{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "almond",
  "name": "AppBlips",
  "colors": {
    "primary": "#080808",
    "light": "#58b9ea",
    "dark": "#ed7a77"
  },
  "favicon": "/favicon.png",
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Get Started",
            "pages": [
              "introduction",
              "quickstart-desktop"
            ]
          },
          {
            "group": "Core Features",
            "pages": [
              "features/building-apps",
              "features/live-preview",
              "features/editing-apps",
              "features/exporting"
            ]
          },
          {
            "group": "Advanced",
            "pages": [
              "self-hosting/security"
            ]
          },
          {
            "group": "Plans and Billing",
            "pages": [
              "pricing"
            ]
          },
          {
            "group": "Reference",
            "pages": [
              "reference/settings",
              "reference/faq",
              "reference/troubleshooting"
            ]
          }
        ]
      }
    ]
  },
  "navbar": {
    "links": [
      {
        "label": "GitHub",
        "href": "https://github.com/techmitten/app-blips"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Open AppBlips",
      "href": "https://appblips.com"
    }
  },
  "description": "Documentation for AppBlips: generate single-file HTML apps and websites from plain English, preview them live, and export or self-host.",
  "logo": {
    "light": "/logo-light.png",
    "dark": "/logo-dark.png"
  },
  "redirects": [
    {
      "source": "/quickstart-self-hosted",
      "destination": "/quickstart-desktop"
    },
    {
      "source": "/self-hosting/docker",
      "destination": "/quickstart-desktop"
    },
    {
      "source": "/self-hosting/configuration",
      "destination": "/quickstart-desktop"
    }
  ]
}
