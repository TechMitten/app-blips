{
  "name": "appblips",
  "description": "Turn a text prompt into a working single-file app or website, with a live sandboxed preview.",
  "author": "Tech Mitten",
  "homepage": "https://appblips.com",
  "private": true,
  "version": "0.1.16",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TechMitten/app-blips.git"
  },
  "main": "dist-electron/main.cjs",
  "desktopName": "appblips.desktop",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build --mode desktop",
    "lint": "eslint .",
    "typecheck": "node scripts/typecheck.js",
    "test:credits": "node --test testing/testCreditsApi.js testing/testCreditsBalance.js testing/testCreditsCatalog.js",
    "check": "npm run typecheck && npm run lint",
    "preview": "vite preview",
    "start": "vite build --mode desktop && node server.js",
    "build:server": "node scripts/build-server.js",
    "licenses": "node scripts/update-licenses.js",
    "desktop": "vite build --mode desktop && node scripts/build-electron.js && electron .",
    "desktop:start": "electron .",
    "desktop:dist": "vite build --mode desktop && node scripts/build-electron.js && electron-builder --publish never",
    "desktop:store": "vite build --mode desktop && node scripts/build-electron.js && electron-builder --win appx --publish never",
    "android:sync": "vite build --mode desktop && cap sync android",
    "android:release": "vite build --mode desktop && cap sync android && cd android && ./gradlew bundleRelease",
    "android:apk": "vite build --mode desktop && cap sync android && cd android && ./gradlew assembleRelease",
    "release": "bash scripts/release.sh"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@huggingface/transformers": "^3.8.1",
    "acorn": "^8.18.0",
    "acorn-jsx": "^5.3.2",
    "capacitor-secure-storage-plugin": "^0.13.0",
    "esbuild-wasm": "^0.28.2",
    "fflate": "^0.8.3",
    "lucide-react": "^0.577.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "sucrase": "^3.35.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.2.2",
    "@vitejs/plugin-react": "^6.0.1",
    "electron": "^44.9.1",
    "electron-builder": "^26.17.0",
    "electron-updater": "^6.8.9",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3",
    "vite": "^8.3.5"
  },
  "overrides": {
    "global-agent": "^4.1.3",
    "@grpc/grpc-js": "^1.14.5",
    "sharp": "^0.35.5"
  }
}
