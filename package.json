{
  "name": "appblips",
  "description": "Turn a text prompt into a working single-file app or website, with a live sandboxed preview.",
  "author": "TechMitten",
  "homepage": "https://appblips.com",
  "private": true,
  "version": "0.1.4",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TechMitten/app-blips.git"
  },
  "main": "dist-electron/main.cjs",
  "desktopName": "appblips.desktop",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build --mode desktop",
    "lint": "eslint .",
    "preview": "vite preview",
    "desktop": "vite build --mode desktop && node scripts/build-electron.js && electron .",
    "desktop:start": "electron .",
    "desktop:dist": "vite build --mode desktop && node scripts/build-electron.js && electron-builder --publish never",
    "release": "bash scripts/release.sh"
  },
  "dependencies": {
    "acorn": "^8.18.0",
    "acorn-jsx": "^5.3.2",
    "lucide-react": "^0.577.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "sucrase": "^3.35.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.2.2",
    "@vitejs/plugin-react": "^6.0.1",
    "electron": "^44.5.1",
    "electron-builder": "^26.17.0",
    "electron-updater": "^6.8.9",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "tailwindcss": "^4.2.2",
    "vite": "^8.0.1"
  },
  "overrides": {
    "global-agent": "^4.1.3",
    "@grpc/grpc-js": "^1.14.5",
    "sharp": "^0.35.5"
  }
}
