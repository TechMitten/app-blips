{
  "name": "appblips",
  "description": "Turn a text prompt into a working single-file app or website, with a live sandboxed preview.",
  "author": "TechMitten",
  "homepage": "https://appblips.com",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TechMitten/app-blips.git"
  },
  "main": "dist-electron/main.cjs",
  "desktopName": "appblips.desktop",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "usage": "node scripts/usage-dashboard.js",
    "desktop": "vite build --mode desktop && node scripts/build-electron.js && electron .",
    "desktop:start": "electron .",
    "desktop:dist": "vite build --mode desktop && node scripts/build-electron.js && electron-builder --publish never"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@marsidev/react-turnstile": "^1.6.1",
    "@supabase/supabase-js": "^2.117.2",
    "acorn": "^8.18.0",
    "lucide-react": "^0.577.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.2.2",
    "@vitejs/plugin-react": "^6.0.1",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-updater": "^6.8.9",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "tailwindcss": "^4.2.2",
    "vite": "^8.0.1"
  }
}
