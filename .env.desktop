# Build-time settings for the desktop app (`vite build --mode desktop`, used by
# the npm desktop scripts). They override .env so a multi-user .env can't leak
# into the desktop bundle. No secrets here: the AI provider is set in the app
# (Settings → AI) and kept in the OS keychain.
#
# Empty Supabase settings force single-user mode even if .env configures
# Supabase for a source/Docker multi-user install.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
APPBLIPS_GENERATED_AI_MODE=relay
APPBLIPS_APP_AI_RELAY_URL=/api/app-ai/chat
