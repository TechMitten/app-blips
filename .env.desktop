# Build-time settings for the desktop app (`vite build --mode desktop`, used by
# the npm desktop scripts). They override .env where set; anything left blank
# here inherits from .env. No secrets here: the AI provider is set in the app
# (Settings → AI) and kept in the OS keychain.
#
# Supabase is not forced off: if .env sets VITE_SUPABASE_URL +
# VITE_SUPABASE_PUBLISHABLE_KEY, the desktop app is built as a multi-user
# client (sign-in, cloud projects, deploys) against that project. Leave them
# unset (and absent from .env) for a single-user desktop build.
APPBLIPS_GENERATED_AI_MODE=relay
APPBLIPS_APP_AI_RELAY_URL=/api/app-ai/chat
