rules_version = '2';

// AppBlips Firestore rules. Clients only ever touch their own profile,
// username claim and projects. Everything that grants or counts something
// (usage, subscriptions, trial cards, deployments, analytics sites) is
// written by the server as the service account, which these rules don't
// apply to; clients can at most read their own deployments.
service cloud.firestore {
  match /databases/{database}/documents {
    // The app only signs in with Google/GitHub. Anonymous accounts are
    // refused too, so if that provider is ever switched on in the console,
    // anyone can't mint throwaway accounts to squat usernames or store data.
    function signedIn() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Lockstep with USERNAME_REGEX in src/lib/username.js and the deploy
    // slug pattern in functions/_lib/deploys.js.
    function validUsername(name) {
      return name is string && name.matches('^[a-z0-9-]{3,39}$');
    }

    // users/{uid}: { username, updated_at }. Created once, together with the
    // usernames/{username} claim, and never changed: the username is
    // permanent. The server deletes it with the account.
    match /users/{uid} {
      allow get: if isOwner(uid);
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['username', 'updated_at'])
        && validUsername(request.resource.data.username)
        && request.resource.data.updated_at == request.time
        && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.username)).data.uid == uid;
    }

    // usernames/{username}: { uid, created_at }. A claim can only be created
    // (writing an existing doc is an update, which is never allowed), only in
    // the same batch as the claimer's first users/{uid} doc, and is never
    // released -- not even when the account is deleted -- so old links under
    // a name can't be taken over. Nor can it match someone else's bare deploy
    // slug: `/<slug>/<page>` would then be shadowed by the claimer's own
    // `<username>/<page>` deploy (the apps host tries that form first).
    // functions/_lib/deploys.js checks the reverse direction.
    match /usernames/{username} {
      allow get: if signedIn() && resource.data.uid == request.auth.uid;
      allow create: if signedIn()
        && validUsername(username)
        && request.resource.data.keys().hasOnly(['uid', 'created_at'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.created_at == request.time
        && !exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.username == username
        && (!exists(/databases/$(database)/documents/deployments/$(username))
          || get(/databases/$(database)/documents/deployments/$(username)).data.user_id == request.auth.uid);
    }

    // projects/{id}: one saved app's metadata; its data lives in the chunks
    // below (src/lib/cloudProjects.js). Owner-only, ids are random UUIDs.
    function validProject(data) {
      return data.keys().hasOnly(['user_id', 'name', 'updated_at', 'rev', 'chunk_count', 'size', 'encoding'])
        && data.user_id == request.auth.uid
        && data.name is string && data.name.size() <= 200
        && data.updated_at == request.time
        && data.rev is string && data.rev.size() <= 64
        && data.chunk_count is int && data.chunk_count >= 1 && data.chunk_count <= 8
        && data.size is int && data.size >= 0 && data.size <= 8 * 921600
        && data.encoding in ['gzip', 'json'];
    }

    match /projects/{projectId} {
      // A missing project reads as "doesn't exist" rather than an error, so a
      // first save can check for an earlier one.
      allow get: if signedIn() && (resource == null || resource.data.user_id == request.auth.uid);
      allow list: if signedIn() && resource.data.user_id == request.auth.uid;
      allow create: if signedIn()
        && projectId.matches('^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$')
        && validProject(request.resource.data);
      allow update: if signedIn() && resource.data.user_id == request.auth.uid
        && (validProject(request.resource.data)
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'updated_at'])
            && request.resource.data.name is string && request.resource.data.name.size() <= 200
            && request.resource.data.updated_at == request.time));
      allow delete: if signedIn() && resource.data.user_id == request.auth.uid;

      // chunks/{n}: { user_id, rev, data: bytes }, written in the same batch
      // as the project doc, whose rev they must carry.
      match /chunks/{n} {
        allow read: if signedIn() && resource.data.user_id == request.auth.uid;
        allow create, update: if signedIn()
          && n.matches('^[0-7]$')
          && (resource == null || resource.data.user_id == request.auth.uid)
          && request.resource.data.keys().hasOnly(['user_id', 'rev', 'data'])
          && request.resource.data.user_id == request.auth.uid
          && request.resource.data.data is bytes
          && request.resource.data.data.size() <= 921600
          && getAfter(/databases/$(database)/documents/projects/$(projectId)).data.user_id == request.auth.uid
          && getAfter(/databases/$(database)/documents/projects/$(projectId)).data.rev == request.resource.data.rev;
        allow delete: if signedIn() && resource.data.user_id == request.auth.uid;
      }
    }

    // deployments/{slug}: written only by POST /api/deploys; the owner can
    // read theirs (the analytics dashboard lists them).
    match /deployments/{slug} {
      allow read: if signedIn() && resource.data.user_id == request.auth.uid;
    }

    // usage, subscriptions, analytics_sites and anything else: server only.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
