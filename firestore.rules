rules_version = '2';
service cloud.firestore {
  // A usage counter field need not be present on a `usage` doc -- the first
  // write of the day only sets whichever counter (builder/deployed) it
  // incremented, so `field in data` guards against the other one being
  // absent rather than assuming both always exist.
  function usageCounterValid(data, field) {
    return !(field in data) || (data[field] is int && data[field] >= 0 && data[field] <= 1);
  }
  function usageCounterDelta(before, after, field) {
    return !(field in after)
      || (!(field in before) && after[field] >= 0 && after[field] <= 1)
      || (field in before && after[field] - before[field] >= 0 && after[field] - before[field] <= 1);
  }

  match /databases/{database}/documents {
    match /projects/{projectId} {
      allow read, delete: if request.auth != null && request.auth.uid == resource.data.user_id;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.user_id;
      allow update: if request.auth != null 
                    && request.auth.uid == resource.data.user_id
                    && request.resource.data.user_id == resource.data.user_id;
    }
    
    match /deployments/{slug} {
      allow read: if true;
      allow delete: if request.auth != null && request.auth.uid == resource.data.user_id;
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.user_id
                    && request.resource.data.storage_path.matches('^' + request.auth.uid + '/.*');
      allow update: if request.auth != null
                    && request.auth.uid == resource.data.user_id
                    && request.resource.data.user_id == resource.data.user_id
                    && request.resource.data.storage_path.matches('^' + request.auth.uid + '/.*');
    }

    // Username reservation: doc ID is the username itself, so a second
    // account can never `create` the same doc (Firestore evaluates a write
    // to an existing doc as an update, and no `allow update` is granted here,
    // so once claimed a username is permanently locked). Read is public so
    // deploy-time slug lookups and availability checks don't need auth.
    match /usernames/{username} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.uid
                    && username.matches('^[a-z0-9-]{3,39}$');
      allow update, delete: if false;
    }

    // Per-user profile. `username` is set at most once: the update rule
    // pins it the same way projects/{projectId} pins user_id above.
    match /users/{uid} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == uid;
      allow update: if request.auth != null && request.auth.uid == uid
                    && (!('username' in resource.data) || !resource.data.username
                        || request.resource.data.username == resource.data.username);
    }

    // Per-account, per-day API usage counters (functions/_lib/usageTracking.js).
    // Written server-side by the /api/chat and /ai/chat proxies. The writes do
    // carry the server's App Check token, but that credential is a debug token
    // (firebaseServer.js), and debug attestation never populates request.app
    // in rules (verified live 2026-09-15 against ENFORCED Firestore) -- a
    // request.app gate here made every write fail silently. So the rules gate
    // purely by shape: known fields only, each counter at most +1 per call,
    // reads owner-only, no deletes. This is observability, not a billing
    // boundary; the worst an unauthenticated writer can do is inflate a counter.
    match /usage/{docId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.user_id;
      allow create: if request.resource.data.keys().hasOnly(['user_id', 'date', 'builderRequests', 'deployedRequests', 'updatedAt'])
                    && usageCounterValid(request.resource.data, 'builderRequests')
                    && usageCounterValid(request.resource.data, 'deployedRequests');
      allow update: if request.resource.data.keys().hasOnly(['user_id', 'date', 'builderRequests', 'deployedRequests', 'updatedAt'])
                    && request.resource.data.user_id == resource.data.user_id
                    && request.resource.data.date == resource.data.date
                    && usageCounterDelta(resource.data, request.resource.data, 'builderRequests')
                    && usageCounterDelta(resource.data, request.resource.data, 'deployedRequests');
      allow delete: if false;
    }
  }
}
